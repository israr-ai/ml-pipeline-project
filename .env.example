# Local docker-compose uses these:
DB_HOST=db
DB_USER=mlproject
DB_PASS=mlproject
DB_NAME=mlproject

# Render (and other hosts) provide a single connection string instead —
# when set, DATABASE_URL takes priority over the DB_* vars above.
# DATABASE_URL=postgresql://user:pass@host/dbname

SECRET_KEY=dev-secret-key
PORT=5000
